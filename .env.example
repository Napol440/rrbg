# Standalone web needs nothing. Discord Activity needs:
# 1) Client id baked into the frontend at build time:
VITE_DISCORD_CLIENT_ID=
# 2) Backend host for the proxy patch helper (no protocol), e.g. rrbg-rooms.onrender.com:
VITE_BACKEND_HOST=
# 3) Server-side (Render env, never VITE_-prefixed):
# DISCORD_CLIENT_ID=<same as above>
# DISCORD_CLIENT_SECRET=<from Developer Portal → OAuth2>
# Optional override for Pages-style deploys pointing at a public rooms server:
# VITE_ROOM_WS=wss://rrbg-rooms.onrender.com/ws
